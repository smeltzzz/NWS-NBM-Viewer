# ─────────────────────────────────────────────────────────────
# NWS NBM Viewer — repository ignore rules
# Golden rule: NEVER commit data artifacts, only code.
# ─────────────────────────────────────────────────────────────

# ── Node / Next.js ──────────────────────────────────────────
node_modules/
.pnpm-store/
.npm/
.yarn/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Environment / secrets ───────────────────────────────────
# .env.example IS committed; everything else is not.
.env
.env.*
!.env.example
*.pem
*.key

# ── NBM data caches & raster artifacts ──────────────────────
# Tile cache root (TILE_CACHE_DIR), DiskCache shards, COG/vsicurl
# scratch files, decoded GRIB, and any temp raster output.
data/
cache/
caches/
.tilecache/
# Anchored on purpose: a bare `tiles/` matches at any depth and would also
# swallow backend/app/tiles/, which is the tiling pipeline source, not output.
/tiles/
/backend/tiles/
rasters/
tmp/
temp/
scratch/

# GRIB2 index sidecars are fetched on demand and are never source.
*.idx
*.grib2
*.grib
*.grib2.idx
*.grb
*.grb2
*.gb2

# Raster / geospatial artifacts
*.tif
*.tiff
*.cog
*.vrt
*.aux.xml
*.ovr
*.hdf
*.nc
*.nc4
*.zarr/
*.pmtiles
*.mbtiles

# ── Local NBM / NOAA dumps ─────────────────────────────────
nbm-inventory*.json
nbm-catalog*.json
inventory-snapshots/
logs/
*.log

# ── Docker / compose local overrides ───────────────────────
docker-compose.override.yml
compose.override.yaml

# ── OS / editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~
