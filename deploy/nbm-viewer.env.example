# /etc/nbm-viewer/nbm.env — shared EnvironmentFile for the systemd units.
# Full documented key reference: repository-root `.env.example`.
#
#   sudo install -d -m 0755 /etc/nbm-viewer
#   sudo install -m 0640 deploy/nbm-viewer.env.example /etc/nbm-viewer/nbm.env
#   sudo chown root:nbm /etc/nbm-viewer/nbm.env
#
# NOTE: variables consumed by systemd ExecStart (`${WEB_CONCURRENCY}`) must
# exist here, otherwise the unit fails to spawn uvicorn.

ENVIRONMENT=production
LOG_LEVEL=info
WEB_CONCURRENCY=4

# ── Upstream data (public NODD bucket; no credentials needed) ───────────────
S3_BUCKET_GRIB=noaa-nbm-grib2-pds
AWS_DEFAULT_REGION=us-east-1
NOMADS_FALLBACK_ENABLED=true

# ── 24/7 operation ───────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
POLLER_ENABLED=true
POLLER_INTERVAL_MINUTES=10
POLLER_WARMUP_ENABLED=true
CACHE_MAX_AGE_HOURS=72
CACHE_EVICTION_MINUTES=60
CACHE_BACKEND=disk
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
CACHE_SIZE_LIMIT_GB=20
TILE_CACHE_DIR=/var/lib/nbm-viewer/cache

# ── CORS (only needed when a browser hits the API cross-origin) ─────────────
CORS_ORIGINS=https://your-domain.example
