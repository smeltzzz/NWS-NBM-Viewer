# ─────────────────────────────────────────────────────────────────────────────
# NWS NBM Viewer — environment configuration template
#
# Copy to `.env` at the repository root:  cp .env.example .env
# Both the FastAPI backend (pydantic-settings) and docker compose read this file.
# Every key is OPTIONAL unless marked REQUIRED — sane production defaults are
# baked into backend/app/config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# 1. APPLICATION / RUNTIME
# ═══════════════════════════════════════════════════════════════════════════
# "development" | "staging" | "production" — gates docs, reload and log format.
ENVIRONMENT=development
# Port the FastAPI backend binds to. (compose maps 8000:${PORT})
PORT=8000
# Interface to bind. Keep 0.0.0.0 inside containers.
HOST=0.0.0.0
# Uvicorn workers. Use 1 with --reload in dev; scale in prod behind a proxy.
WEB_CONCURRENCY=1
# "debug" | "info" | "warning" | "error" | "critical"
LOG_LEVEL=info
# Versioned API prefix — must stay in sync with frontend API_BASE_PATH.
API_PREFIX=/api/v1

# ═══════════════════════════════════════════════════════════════════════════
# 2. CORS  (browser origins allowed to call the API directly)
# ═══════════════════════════════════════════════════════════════════════════
# Comma-separated exact origins. Used when the frontend calls the API
# cross-origin (e.g. Vercel frontend -> Fly.io backend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Regex for ephemeral preview deployments (Arena/E2B/Vercel). Empty = disabled.
CORS_ORIGIN_REGEX=^https?://([a-z0-9-]+\.)*(localhost|e2b\.app|arena\.ai|vercel\.app|pages\.dev)(:\d+)?$

# ═══════════════════════════════════════════════════════════════════════════
# 3. NOAA OPEN DATA DISSEMINATION (NODD) — AWS S3, NO AUTH REQUIRED
# ═══════════════════════════════════════════════════════════════════════════
# GRIB2 + .idx bucket (core & qmd products, raw byte-range reads).
S3_BUCKET_GRIB=noaa-nbm-grib2-pds
# Cloud-Optimized GeoTIFF bucket (NBM-derived mosaics / pre-rendered COGs).
S3_BUCKET_COG=noaa-nbm-pds
# NODD is us-east-1 only.
AWS_DEFAULT_REGION=us-east-1
# NODD buckets are public and anonymous — do NOT set credentials by default.
# Only fill these in for private mirrors or MinIO/LocalStack testing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Override for S3-compatible endpoints (MinIO/LocalStack). Empty = real AWS.
S3_ENDPOINT_URL=
# Verify TLS on S3 requests. Only disable for local test endpoints.
S3_VERIFY_TLS=true
# SigV4 signing is unnecessary for public NODD buckets; keep off to avoid
# 403s from anonymous-only bucket policies.
S3_USE_SIGNATURE_V4=false

# Key layout inside S3_BUCKET_GRIB. NOMADS/NODD expose the {core|qmd} layout;
# some NODD mirrors publish everything under a flat `grib2/` prefix instead.
# The inventory service uses this template and falls back automatically.
#   normalised : blend.{date}/\{cycle\}/{product}/blend.t{cycle}z.{product}.f{hour:03d}.{domain}.grib2
#   flat       : blend.{date}/\{cycle\}/grib2/blend.t{cycle}z.{product}.f{hour:03d}.{domain}.grib2
S3_GRIB_KEY_TEMPLATE=blend.{date}/{cycle}/{product}/blend.t{cycle}z.{product}.f{hour:03d}.{domain}.grib2
# Optional alt layout probed when the primary template 404s.
S3_GRIB_KEY_TEMPLATE_FALLBACK=blend.{date}/{cycle}/grib2/blend.t{cycle}z.{product}.f{hour:03d}.{domain}.grib2
# COG layout in S3_BUCKET_COG (NBM-derived tiled products).
COG_KEY_TEMPLATE=blendv4.2/{domain}/{date}/{cycle}/{variable}/{variable}.t{cycle}z.f{hour:03d}.{domain}.tif

# ═══════════════════════════════════════════════════════════════════════════
# 4. NOAA NOMADS HTTP FALLBACK  (used when S3 is unreachable / degraded)
# ═══════════════════════════════════════════════════════════════════════════
NOMADS_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/blend/prod
# Enable automatic failover from NODD S3 to NOMADS HTTP.
NOMADS_FALLBACK_ENABLED=true
# Per-request timeout (seconds) for upstream data fetches.
UPSTREAM_TIMEOUT_SECONDS=20
# Timeout for the lightweight health-check probe of upstream hosts.
UPSTREAM_PROBE_TIMEOUT_SECONDS=2.5
# Probe NODD/NOMADS reachability inside /health responses (results memoized).
UPSTREAM_PROBE_ENABLED=true
# How long a probe result is cached before re-probing (seconds).
UPSTREAM_PROBE_CACHE_SECONDS=60

# ═══════════════════════════════════════════════════════════════════════════
# 5. CACHING  (tile cache, decoded arrays, GRIB byte-range windows)
# ═══════════════════════════════════════════════════════════════════════════
# DiskCache root. Mounted as a volume in compose. Ignored by git.
TILE_CACHE_DIR=./data/tilecache
# Max on-disk cache size in GB (DiskCache evicts LRU past this).
CACHE_SIZE_LIMIT_GB=20
# TTL in seconds for rendered map tiles (NBM updates hourly).
TILE_CACHE_TTL_SECONDS=3600
# TTL in seconds for parsed GRIB .idx inventories.
INVENTORY_CACHE_TTL_SECONDS=300
# "disk" (default, zero-dependency) | "redis" (shared across replicas)
CACHE_BACKEND=disk
# Only used when CACHE_BACKEND=redis.
REDIS_URL=redis://redis:6379/0

# ═══════════════════════════════════════════════════════════════════════════
# 6. NBM MODEL DEFAULTS  (initial UI state)
# ═══════════════════════════════════════════════════════════════════════════
# co=CONUS 2.5km | ak=Alaska 3km | hi=Hawaii 2.5km | pr=Puerto Rico 1.25km
# | gu=Guam 2.5km | oc=Oceanic 10km
NBM_DEFAULT_DOMAIN=co
# co/ak/hi/pr/gu run hourly (00-23z); qmd products run 00/06/12/18z.
NBM_DEFAULT_PRODUCT=core
NBM_DEFAULT_VARIABLE=tmp
NBM_DEFAULT_FORECAST_HOUR=24
NBM_MAX_FORECAST_HOUR=264
# Percentiles published by NBM (1-99 for PQPF / PMaxT / PMinT).
NBM_DEFAULT_PERCENTILE=50

# ═══════════════════════════════════════════════════════════════════════════
# 7. TILING / RENDERING
# ═══════════════════════════════════════════════════════════════════════════
# Web-mercator tile zoom range served by rio-tiler.
TILE_MIN_ZOOM=0
TILE_MAX_ZOOM=12
# 256 | 512 (512 improves sharpness for contour-ish rasters).
TILE_SIZE=256
# Resampling used when reprojecting NBM Lambert grids to EPSG:3857.
TILE_RESAMPLING=bilinear
# Server-side colour ramp evaluation (faster) vs raw values for client-side
# colormapping. "server" | "raw".
COLORMAP_MODE=server
# Comma-separated allowed colour-map names exposed by /api/v1/colormaps.
COLORMAPS_DEFAULT=nbm_temp,nbm_precip,nbm_wind,nbm_rh,nbm_pop

# ═══════════════════════════════════════════════════════════════════════════
# 8. BACKGROUND SCHEDULER + ACTIVE-CYCLE POLLER (app.cron.poller)
#    The poller keeps /api/v1/runs/latest pointed at the newest NOAA cycle,
#    warms root tiles (z3/4/5) on publication, and enforces disk retention.
#    Recommended for production: SCHEDULER_ENABLED=true + POLLER_ENABLED=true.
# ═══════════════════════════════════════════════════════════════════════════
SCHEDULER_ENABLED=false
# Minutes between inventory refreshes (NBM publishes at :25-:40 past the hour).
INVENTORY_REFRESH_MINUTES=15
# Pre-warm the most recent CONUS cycle on startup (slow first boot; off in dev).
CACHE_WARMUP_ON_START=false
# Master switch for the poller (still requires SCHEDULER_ENABLED=true).
POLLER_ENABLED=true
# Minutes between NOAA S3 discovery ticks (10 = responsive yet courteous).
POLLER_INTERVAL_MINUTES=10
# Hours f001..fNNN that must all exist before a cycle counts as complete.
POLLER_COMPLETE_WINDOW_HOURS=36
# Flag /runs/latest as `stale` when no new cycle appears within this many minutes.
POLLER_STALE_AFTER_MINUTES=90
# Back-off after S3 throttling: base * 2^n, capped; jittered.
POLLER_BACKOFF_BASE_SECONDS=60
POLLER_BACKOFF_MAX_SECONDS=900
# /runs/latest serves the pointer while younger than this (seconds).
POINTER_FRESHNESS_SECONDS=1200
# Expose GET /api/v1/poller/status + POST /api/v1/poller/{poll,evict}.
POLLER_OPS_ENDPOINTS_ENABLED=true
# Warm-up plan: root zooms, key national products, and forecast hours.
POLLER_WARMUP_ENABLED=true
POLLER_WARMUP_ZOOMS=3,4,5
POLLER_WARMUP_ELEMENTS=tmp,qpf_6h,max,min,gust
POLLER_WARMUP_HOURS=1,3,6,12,18,24,36
POLLER_WARMUP_CONCURRENCY=3
# Evict cached tiles older than this many hours (bounding TILE_CACHE_DIR).
CACHE_MAX_AGE_HOURS=72
CACHE_EVICTION_MINUTES=60
# Bounded retries with exponential backoff on S3 429/503 (graceful degradation).
S3_RETRY_MAX_ATTEMPTS=3
S3_RETRY_BASE_DELAY_SECONDS=0.5
S3_RETRY_MAX_DELAY_SECONDS=8
S3_THROTTLE_COOLDOWN_SECONDS=30

# ═══════════════════════════════════════════════════════════════════════════
# 9. FRONTEND  (Next.js — NEXT_PUBLIC_* is inlined into the browser bundle)
# ═══════════════════════════════════════════════════════════════════════════
# Browser-visible API path. Relative by default so the Next.js rewrite proxy
# forwards /api/v1/* to the backend server-side (no CORS, works behind any host).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Server-side (container-to-container) proxy target used by next.config rewrites.
# In compose this is http://backend:8000; locally http://127.0.0.1:8000.
API_PROXY_TARGET=http://127.0.0.1:8000
# Map initial camera (CONUS default).
NEXT_PUBLIC_MAP_CENTER_LON=-97.5
NEXT_PUBLIC_MAP_CENTER_LAT=38.5
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=4
# Basemap raster style: "dark" | "light" | "osm". Dev default; swap for a
# licensed basemap (MapTiler/Stadia) in production.
NEXT_PUBLIC_BASEMAP=dark
# Optional MapTiler/Stadia key if NEXT_PUBLIC_BASEMAP is overridden with a
# custom style URL.
NEXT_PUBLIC_BASEMAP_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 10. DOCKER COMPOSE PORTS  (host side only)
# ═══════════════════════════════════════════════════════════════════════════
FRONTEND_PORT=3000
BACKEND_PORT=8000
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════════════════════
# 11. TILE RASTER TUNING  (defaults are production-tuned; touch sparingly)
# ═══════════════════════════════════════════════════════════════════════════
# Data source for tile grids: auto | s3 | local | synthetic.
#   auto      — NODD S3 with NOMADS fallback (production)
#   synthetic — deterministic offline rasters for UI work without NOAA
TILE_DATA_SOURCE=auto
# Local GRIB override dir when TILE_DATA_SOURCE=local.
TILE_GRIB_DIR=data/grib
# Offline demo mode: serve synthetic tiles even when NOAA is reachable.
NBM_TILE_OFFLINE=false
# Response for tiles fully outside the domain: no_content (204) | image.
# The gateway caches either shape; 204 is a byte-cheaper way to say "no data".
TILE_EMPTY_RESPONSE=no_content
# WebP encoding for tiles (lossy is ~5-10x smaller than PNG at visual parity).
TILE_WEBP_QUALITY=82
TILE_WEBP_LOSSLESS=false
TILE_WEBP_METHOD=4
# Warp thread budget per tile render and bilinear smoothing radius on the
# source grid (0 = raw nearest-neighbour look of the model grid).
TILE_WARP_THREADS=2
TILE_SMOOTH_RADIUS=1
# In-memory source-grid LRU shared by all workers of one process: bounds RAM
# during render bursts (warm-up) and avoids re-decoding neighbouring tiles.
TILE_GRID_CACHE_MB=512
TILE_GRID_CACHE_ENTRIES=128
# Downsample factor applied to synthetic grids (dev mode only).
TILE_SYNTHETIC_DOWNSAMPLE=4
# Cache TTL layering (seconds): the LIVE cycle's tiles are volatile while NOAA
# still posts hours of it — short TTL + frequent revalidation; historical
# cycles are immutable and kept for the full CACHE_MAX_AGE_HOURS window.
TILE_CACHE_TTL_LATEST_SECONDS=300
TILE_CACHE_MAX_AGE_LATEST=300
TILE_CACHE_MAX_AGE_HISTORICAL=86400

# ═══════════════════════════════════════════════════════════════════════════
# 12. RUN DISCOVERY, HTTP TIME-OUTS & MISC
# ═══════════════════════════════════════════════════════════════════════════
# How far back the live "latest run" scan accepts cycles, and how many S3
# LISTING probes run in parallel during a poll tick (per domain+product).
LATEST_CYCLE_TOLERANCE_HOURS=3
POLLER_LOOKBACK_HOURS=24
POLLER_PROBE_CONCURRENCY=12
# Low-level botocore timeouts (connect is fail-fast; read covers ranged GETs).
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=30
# Connection pool per worker — keep ≥ poller_probe_concurrency + tile burst.
S3_MAX_POOL_CONNECTIONS=32
# Extra FastAPI metadata toggle.
DEBUG=false
# API metadata shown at /docs (APP_VERSION also feeds /health/version).
APP_NAME=NWS NBM Viewer API
APP_VERSION=0.1.0
APP_DESCRIPTION=Real-time tile and metadata API for the NOAA/NWS National Blend of Models (NBM v4.2+).
